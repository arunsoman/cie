["o", 67.357422, "\u001b]0;\u25d0 resolve_backend call graph and tests\u0007\u001b[?25l\u001b[H\u001b[5Gchokepoint\u001b[16Gevery\u001b[22GCLI\u001b[26Gquery\u001b[32Gcommand\u001b[40Ggoes\u001b[45Gthrough.\u001b[54GIt\u001b[57Gadditionally\u001b[70Graises\u001b[77G\u001b[38;2;177;185;249mFileNotFoundError\u001b[95G\u001b[39mif\r\u001b[2C\u001b[1B \u001b[5G\u001b[38;2;177;185;249mmode == \"embedde\u001b[22G\"\u001b[39m but the graph file doesn't exist \u2014 so a change that makes \u001b[38;2;177;185;249mresolve_backend\u001b[39m\u001b[K\r\u001b[4C\u001b[1Breturn \u001b[38;2;177;185;249m\"embedded\"\u001b[39m in\u001b[26Ga new\u001b[33Gase will surface as \u001b[3mthat\u001b[23m error, not a re\u001b[74Golve_backend error.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[38;2;177;185;249m_\u001b[7Gp\u001b[9Gn_backend\u001b[39m in turn gat\u001b[31Gs the four construction site\u001b[60G:\u001b[62G\u001b[38;2;177;185;249m_open_engine\u001b[39m,\u001b[76G\u001b[38;2;177;185;249m_open_ta\u001b[85Gk_r\u001b[89Gpo\u001b[39m,\u001b[K\r\u001b[4C\u001b[1B\u001b[38;2;177;185;249m_open_hi\u001b[14Grarchy_repo\u001b[39m, \u001b[38;2;177;185;249m_open_tool_service\u001b[39m (all \u001b[38;2;177;185;249mcie/cli.py\u001b[39m) \u2014\u001b[65Gevery\u001b[71GCLI qu\u001b[78Gry \u001b[82Gommand builds\u001b[96Gits\r\u001b[2C\u001b[1B \u001b[5Gengine/repo through one of these.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[38;2;177;185;249mcie/facto\u001b[15Gy.py\u001b[39m: \u001b[38;2;177;185;249mbuild_driver\u001b[39m, \u001b[38;2;177;185;249mget_\u001b[40Gng\u001b[43Gn\u001b[45G\u001b[39m, \u001b[38;2;177;185;249mbuild_too\u001b[57G_service\u001b[39m \u2014 these are where \u001b[38;2;177;185;249m\"embedded\"\u001b[39m vs\u001b[K\r\u001b[4C\u001b[1B\u001b[38;2;177;185;249m\"neo4j\"\u001b[39m actually picks SQLi\u001b[33Ge-embedded\u001b[44Gstorage\u001b[52Gvs.\u001b[56Ga\u001b[58GNeo4j\u001b[64Gdriver.\r\u001b[8C\u001b[1B\u001b[38;2;177;185;249mmcp_server.py::main\u001b[39m branches directly\u001b[47Gon the string, so a third possibl\u001b[81G return value\u001b[95G(or\u001b[99Ga\r\u001b[4C\u001b[1Btypo in\u001b[13G\u001b[38;2;177;185;249m\"embedded\"\u001b[39m/\u001b[38;2;177;185;249m\"neo4j\"\u001b[39m) br\u001b[36Gaks the\u001b[44G\u001b[38;2;177;185;249mif/else\u001b[52G\u001b[39mthere\u001b[58Gsilently (falls\u001b[74Gto\u001b[77Gthe\u001b[81GNeo4j\u001b[87Gbranch).\r\u001b[8C\u001b[1B\u001b[38;2;177;185;249mroutes.py\u001b[39m: \u001b[38;2;177;185;249m_health_payload\u001b[39m, \u001b[38;2;177;185;249m_tool_coverage_report\u001b[39m, \u001b[38;2;177;185;249m_tool_coverage_trend\u001b[39m,\u001b[82G\u001b[38;2;177;185;249m_tool_get_coverage\r\u001b[4C\u001b[1B\u001b[39m\u2014 health/coverage HTTP routes depend on which backend got constructed upstream.\u001b[K\r\u001b[8C\u001b[1B\u001b[38;2;177;185;249mt\u001b[11Gols/__init__.py::_speculative_engin\u001b[47G\u001b[39m and \u001b[38;2;177;185;249mcie/cli.py::bootst\u001b[72Gp\u001b[39m, \u001b[38;2;177;185;249mcli\u001b[39m, \u001b[38;2;177;185;249mwatch\u001b[39m \u2014 also\u001b[K\r\u001b[4C\u001b[1Bdownstream, though \u001b[38;2;177;185;249mwatch\u001b[39m/\u001b[38;2;177;185;249mbootstrap\u001b[39m/\u001b[38;2;177;185;249mload\u001b[39m/\u001b[38;2;177;185;249mserve\u001b[51G\u001b[39mare documented as in\u001b[73Gntionally bypassing\u001b[93Gthis\r\u001b[2C\u001b[1B \u001b[5G(Neo4j-only ingest commands per the \u001b[38;2;177;185;249m_ope\u001b[46G_backend\u001b[39m docstring).\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1m3. Tests that would catch a regression\u001b[22m\u001b[K\r\u001b[2C\u001b[2B\u001b[1mDirect, one per resolu\u001b[26Gion-o\u001b[32Gde\u001b[35G branch\u001b[43G\u001b[22m\u2014\u001b[45Gall\u001b[49Gin\u001b[52G\u001b[38;2;177;185;249mtests/test_backend_selection.py\u001b[39m,\u001b[85Ginside\u001b[92G\u001b[38;2;177;185;249mclass \r\u001b[2C\u001b[1BTestResolveBackend\u001b[39m:\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B- \u001b[38;2;177;185;249mt