["o", 69.640914, "\u001b[?25l\u001b[H\u001b[3G-\u001b[5G\u001b[38;2;177;185;249mcie/mcp_server.py::main\u001b[29G\u001b[39mbranches directly\u001b[47Gon\u001b[50Gthe\u001b[54Gstring,\u001b[62Gso\u001b[65Ga\u001b[67Gthird\u001b[73Gpossible\u001b[82Greturn\u001b[89Gvalue\u001b[95G(or\u001b[99Ga\r\u001b[2C\u001b[1B \u001b[5Gtypo in \u001b[38;2;177;185;249m\"embedded\"\u001b[39m/\u001b[38;2;177;185;249m\"neo4j\"\u001b[39m) breaks the \u001b[38;2;177;185;249mif/else\u001b[39m there silently (falls\u001b[74Gto the N\u001b[83Go4j branch).\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[38;2;177;185;249mci\u001b[8G/routes.py\u001b[39m: \u001b[38;2;177;185;249m_health_payload\u001b[39m, \u001b[38;2;177;185;249m_tool_coverage_report\u001b[39m, \u001b[38;2;177;185;249m_tool_coverage_trend\u001b[39m,\u001b[82G\u001b[38;2;177;185;249m_tool_get_coverage\r\u001b[2C\u001b[1B\u001b[39m \u001b[5G\u2014 health/coverage HTTP routes depend on which backend \u001b[60Got cons\u001b[68Gructed upstr\u001b[81Gam.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[38;2;177;185;249mcie/tools/__init__.py::_speculative_eng\u001b[45Gne\u001b[39m and\u001b[52G\u001b[38;2;177;185;249mcie/cli.py::bootstrap\u001b[39m, \u001b[38;2;177;185;249mcli\u001b[39m, \u001b[38;2;177;185;249mwatch\u001b[39m \u2014 also\u001b[K\r\u001b[2C\u001b[1B \u001b[5Gdownstream, though \u001b[38;2;177;185;249mwatch\u001b[39m/\u001b[38;2;177;185;249mbo\u001b[33Gtstrap\u001b[39m/\u001b[38;2;177;185;249mload\u001b[39m/\u001b[38;2;177;185;249ms\u001b[48Gve\u001b[39m are documented as intentionally bypassing this\u001b[K\r\u001b[4C\u001b[1B(Neo4j-only ingest commands per the \u001b[38;2;177;185;249m_open_backend\u001b[39m docstring).\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1m3. Tests that would catch a regression\u001b[22m\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mDirect, one per resolution-order branch\u001b[43G\u001b[22m\u2014\u001b[45Gall\u001b[49Gin\u001b[52G\u001b[38;2;177;185;249mtests/test_backend_selection.py\u001b[39m,\u001b[85Ginside\u001b[92G\u001b[38;2;177;185;249mclass \r\u001b[2C\u001b[1BTestResolveBackend\u001b[39m:\u001b[K\r\u001b[2C\u001b[2B- \u001b[38;2;177;185;249mtest_flag_beats_env_and_auto\u001b[39m (L32) \u2014 explicit \u001b[38;2;177;185;249m--backend\u001b[39m wins over everything\u001b[K\r\u001b[2C\u001b[1B- \u001b[38;2;177;185;249mtest_en\u001b[13G_beats_alias_and_auto\u001b[35G\u001b[39m(L40)\u001b[41G\u2014\u001b[43G\u001b[38;2;177;185;249mCIE_BACKEND\u001b[55G\u001b[39mwins\u001b[60Gover\u001b[65Gthe\u001b[69G\u001b[38;2;177;185;249m--embedded\u001b[80G\u001b[39malias\r\u001b[2C\u001b[1B-\u001b[5G\u001b[38;2;177;185;249mtest_embedded_alias_beats_auto\u001b[36G\u001b[39m(L46)\u001b[42G\u2014\u001b[44Glegacy\u001b[51G\u001b[38;2;177;185;249m--embedded\u001b[62G\u001b[39malias\u001b[68Gstill\u001b[74Gworks\r\u001b[9C\u001b[1B\u001b[38;2;177;185;249mauto\u001b[15Gprefers_existing_graph_file\u001b[39m (L51) \u2014\u001b[51Gauto-detect via \u001b[38;2;177;185;249mdb_path.exists()\r\u001b[10C\u001b[1Bxplici\u001b[18G_auto_fl\u001b[27Gg_f\u001b[31Glls_through_to_detection\u001b[39m (L58) \u2014 the specific bug f\u001b[83Gxed\u001b[87G2026-08-31:\r\u001b[2C\u001b[1B \u001b[5G\u001b[38;2;177;185;249m--backend auto\u001b[39m must fall through, not be treated as truthy\u001b[K\r\u001b[9C\u001b[1B\u001b[38;2;177;185;249menv_is_tolerant_not_fatal\u001b[39m (L68) \u2014 garbage \u001b[38;2;177;185;249mCIE_BACKEND\u001b[39m v\u001b[66Glue doesn't crash,\u001b[85Gfalls\u001b[91Gthrough\r\u001b[18C\u001b[1B\u001b[38;2;177;185;249menv_va\u001b[26Gue\u001b[29Gc\u001b[31Gn_be_passed\u001b[43Gin\u001b[39m (L77)\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BThese 7 are your regression net for the resolution-order logic itself \u2014 run \u001b[38;2;177;185;249mpytest \u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;177;185;249mtest\u001b[8G/t\u001b[11Gst_backend_selection.py -v\u001b[39m.\u001b[K\u001b[30;1H\u001b[28;3H\u001b[?25h"]
