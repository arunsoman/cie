["o", 59.562718, "\u001b[?25l\u001b[H\r\u001b[1B\u001b[48;2;55;55;55m\u001b[38;2;80;80;80m\u276f \u001b[38;2;255;255;255mI want to change how resolve_backend picks a storage backend. What calls it, what breaks \u001b[39m         \r\u001b[1B  \u001b[38;2;255;255;255mdo\u001b[6Gns\u001b[9Gream, \u001b[17Gd w\u001b[21Gich tests would catch a regression? Be specific with files\u001b[80Gand test names.\r\u001b[1B\u001b[39m\u001b[49m\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mCalled cie \u001b[1m13\u001b[22m times \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m\u25cf\u001b[3G\u001b[38;2;177;185;249m\u001b[1mresolve_backend\u001b[39m \u2014 callers, blast radius, tests\r\u001b[1B\u001b[22m\u001b[K\r\u001b[2C\u001b[1B\u001b[1mLocation:\u001b[13G\u001b[22m\u001b[38;2;177;185;249mcie/config.py:155-197\r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[1m1. Direct callers (2 production call sites, both thin adapters)\r\u001b[2C\u001b[1B\u001b[22m\u001b[K\r\u001b[2C\u001b[1B\u001b[1mCaller:\u001b[11G\u001b[22m\u001b[38;2;177;185;249m_selected_backend(ctx)\r\u001b[2C\u001b[1B\u001b[39m\u001b[1mFi\u001b[6Ge:\u001b[22m \u001b[38;2;177;185;249mcie/c\u001b[15Gi.py:90\u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[1mWhat it does with the result:\u001b[33G\u001b[22mAdapter\u001b[41Gfor\u001b[45Gthe\u001b[49G\u001b[38;2;177;185;249mcie\u001b[53G\u001b[39mCLI.\u001b[58GPasses\u001b[65G\u001b[38;2;177;185;249mctx.obj[\"backend_opt\"]\u001b[88G\u001b[39m(the\r\u001b[2C\u001b[1B\u001b[38;2;177;185;249m--backend\u001b[39m/\u001b[38;2;177;185;249mCIE_BACKEND\u001b[39m value, possibly\u001b[41Gthe\u001b[45Gliteral\u001b[53Gstring \u001b[38;2;177;185;249m\"auto\"\u001b[39m) and\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;177;185;249mdb_path=_embedded_db_path(...)\u001b[39m.\u001b[K\r\u001b[2C\u001b[1B\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\r\u001b[2C\u001b[1B\u001b[1mCaller:\u001b[22m \u001b[38;2;177;185;249mmain(argv)\u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[1mFi\u001b[6Ge:\u001b[22m \u001b[38;2;177;185;249mcie/mcp_server.py:198\r\u001b[2C\u001b[1B\u001b[39m\u001b[1mWhat it does with the result:\u001b[33G\u001b[22mEntry\u001b[39Gpoint\u001b[45Gfor\u001b[49Gthe\u001b[53G\u001b[38;2;177;185;249mcie-mcp\u001b[61G\u001b[39mconsole\u001b[69Gscript.\u001b[77GPasses\u001b[84G\u001b[38;2;177;185;249margs.backend\u001b[39m,\r\u001b[2C\u001b[1B\u001b[38;2;177;185;249membedded_flag=args.embedded\u001b[39m (the legacy \u001b[38;2;177;185;249m--embedded\u001b[39m alias), a\u001b[64Gd \u001b[38;2;177;185;249mdb_path\u001b[39m. Branch\u001b[84Gimmediately on\r\u001b[2C\u001b[1Bthe return value (\u001b[38;2;177;185;249m\"\u001b[30G\"\u001b[39m \u2192 \u001b[38;2;177;185;249mbuild_tool_servic\u001b[52G_embedded\u001b[39m, else \u2192 \u001b[38;2;177;185;249mbuild_tool_service_from_config\r\u001b[2C\u001b[1B\u001b[39m with Neo4j).\u001b[K\r\u001b[3C\u001b[1B\u001b[K\u001b[30;1H\u001b[28;3H\u001b[?25h"]
["o", 60.144183, "\u001b[?25l\u001b[H\u001b[38;2;255;255;255m\u25cf\u001b[3G\u001b[38;2;177;185;249m\u001b[1mresolve_backend\u001b[39m \u2014 callers, blast radius, tests\r\u001b[1B\u001b[22m\u001b[K\r\u001b[1B  \u001b[1mLocation:\u001b[22m \u001b[38;2;177;185;249mcie/config.py:155-197\u001b[39m\u001b[K\r\u001b[2C\u001b[2B\u001b[1m1. Direct callers (2 production call sites, both thin adapters)\r\u001b[2B\u001b[22m \u001b[3G\u001b[1mCaller:\u001b[22m \u001b[38;2;177;185;249m_selected_backend(ctx)\u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[1mFile:\u001b[9G\u001b[22m\u001b[38;2;177;185;249mcie/cli.py:90\r\u001b[2C\u001b[1B\u001b[39m\u001b[1mWhat \u001b[9Gt does with the result:\u001b[22m Adapter\u001b[41Gfor\u001b[45Gthe\u001b[49G\u001b[38;2;177;185;249mcie\u001b[53G\u001b[39mCLI.\u001b[58GPasses\u001b[65G\u001b[38;2;177;185;249mctx.obj[\"backend_opt\"]\u001b[88G\u001b[39m(the\r\u001b[2C\u001b[1B\u001b[38;2;177;185;249m--backend\u001b[39m/\u001b[38;2;177;185;249mCIE_BACKEND\u001b[25G\u001b[39mvalue,\u001b[32Gpossibly\u001b[41Gthe\u001b[45Gliteral\u001b[53Gstring\u001b[60G\u001b[38;2;177;185;249m\"auto\"\u001b[39m)\u001b[68Gand\r\u001b[2C\u001b[1B\u001b[38;2;177;185;249mdb_path=_embedded_db_path(...)\u001b[39m.\u001b[K\r\u001b[2C\u001b[1B\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\r\u001b[10C\u001b[1B\u001b[38;2;177;185;249mmain(argv)\u001b[39m\u001b[K\r\u001b[12C\u001b[1B\u001b[38;2;177;185;249mmcp_server.py:198\r\u001b[32C\u001b[1B\u001b[39mEntry point\u001b[45Gfor\u001b[49Gthe\u001b[53G\u001b[38;2;177;185;249mcie-mcp\u001b[39m console script. Passes \u001b[38;2;177;185;249margs.backend\u001b[39m,\r\u001b[2C\u001b[1B\u001b[38;2;177;185;249mem\u001b[6Gedd\u001b[10Gd_flag=args.embedded\u001b[39m (the legacy \u001b[38;2;177;185;249m--embedded\u001b[39m al\u001b[57Gas), and \u001b[38;2;177;185;249mdb_path\u001b[39m.\u001b[75GBranches\u001b[84Gimmediately\u001b[96Gon\r\u001b[2C\u001b[1Bthe return value (\u001b[38;2;177;185;249m\"embedded\"\u001b[39m \u2192 \u001b[38;2;177;185;249mbuild_tool_service_embedded\u001b[39m,\u001b[63Gelse\u001b[68G\u2192\u001b[70G\u001b[38;2;177;185;249mbuild_tool_service_from_config\r\u001b[2C\u001b[1B\u001b[39m with Neo4j).\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BNo other non-test code calls\u001b[32Git\u001b[35Gdirectly\u001b[44G\u2014\u001b[46Git\u001b[49Greally\u001b[56Gis\u001b[59Gcentralized\u001b[71Gto\u001b[74Gthose\u001b[80Gtwo\u001b[84Gadapters,\u001b[94Gwhich\r\u001b[2C\u001b[1Bis the point of the \"ONE rule\" docstring.\u001b[45G\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1m2. Downstream blast radius (from \u001b[38;2;177;185;249maffected_by\u001b[39m, distance 1\u21922)\u001b[63G\u001b[22m\u001b[K\r\u001b[3C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B-\u001b[30;1H\u001b[28;3H\u001b[?25h"]
