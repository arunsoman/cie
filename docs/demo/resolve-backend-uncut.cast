["o", 64.50383, "\u001b[?25l\u001b[H\u001b[3G\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[K\r\u001b[2C\u001b[1B\u001b[1mCaller:\u001b[22m \u001b[38;2;177;185;249mmain(argv)\u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[1mFile:\u001b[22m \u001b[38;2;177;185;249mcie/mcp_server.py:198\u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[1mWhat it does with the result:\u001b[33G\u001b[22mEntry\u001b[39Gpoint\u001b[45Gfor\u001b[49Gthe\u001b[53G\u001b[38;2;177;185;249mcie-mcp\u001b[61G\u001b[39mconsole\u001b[69Gscript.\u001b[77GPasses\u001b[84G\u001b[38;2;177;185;249margs.backend\u001b[39m,\r\u001b[2C\u001b[1B\u001b[38;2;177;185;249membedded_flag=args.embedded\u001b[31G\u001b[39m(the\u001b[36Glegacy\u001b[43G\u001b[38;2;177;185;249m--embedded\u001b[54G\u001b[39malias),\u001b[62Gand\u001b[66G\u001b[38;2;177;185;249mdb_path\u001b[39m.\u001b[75GBranches\u001b[84Gimmediately\u001b[96Gon\r\u001b[2C\u001b[1Bthe return value (\u001b[38;2;177;185;249m\"embedded\"\u001b[39m \u2192 \u001b[38;2;177;185;249mbuild_tool_service_embedded\u001b[39m, else \u2192 \u001b[38;2;177;185;249mbuild_tool_service_from_config\r\u001b[2C\u001b[1B\u001b[39m with Neo4j).\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BNo other non-test\u001b[21Gcode\u001b[26Gcalls\u001b[32Git\u001b[35Gdirectly\u001b[44G\u2014\u001b[46Git\u001b[49Greally\u001b[56Gis\u001b[59Gcentralized\u001b[71Gto\u001b[74Gthose\u001b[80Gtwo\u001b[84Gadapters,\u001b[94Gwhich\r\u001b[2C\u001b[1Bis\u001b[6Gthe\u001b[10Gpoint\u001b[16Gof\u001b[19Gthe\u001b[23G\"ONE\u001b[28Grule\"\u001b[34Gdocstring.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1m2. Downstream blast radius (from \u001b[38;2;177;185;249maffected_by\u001b[39m, distance 1\u21922)\r\u001b[2C\u001b[2B\u001b[22m- \u001b[38;2;177;185;249m_selected_backend\u001b[39m is itself wrapped by \u001b[45G\u001b[38;2;177;185;249m\u001b[1mopen_backend\u001b[22m\u001b[39m (\u001b[38;2;177;185;249mcie/cli.py:119-142\u001b[39m),\u001b[80Gwhich\u001b[86Gis\u001b[89Gthe\u001b[93Gactual\r\u001b[4C\u001b[1Bchokepoint\u001b[16Gevery\u001b[22GCLI\u001b[26Gquery\u001b[32Gcommand\u001b[40Ggoes\u001b[45Gthrough.\u001b[54GIt\u001b[57Gadditionally\u001b[70Graises\u001b[77G\u001b[38;2;177;185;249mFileNotFoundError\u001b[95G\u001b[39mif\r\u001b[2C\u001b[1B \u001b[5G\u001b[38;2;177;185;249mmode == \"embedde\u001b[22G\"\u001b[39m but the graph file doesn't exist \u2014 so a change that makes \u001b[38;2;177;185;249mresolve_backend\u001b[39m\u001b[K\r\u001b[4C\u001b[1Breturn \u001b[38;2;177;185;249m\"embedded\"\u001b[39m in\u001b[26Ga new\u001b[33Gase will surface as \u001b[3mthat\u001b[23m error, not a re\u001b[74Golve_backend error.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[38;2;177;185;249m_\u001b[7Gp\u001b[9Gn_backend\u001b[39m in turn gat\u001b[31Gs the four construction site\u001b[60G:\u001b[62G\u001b[38;2;177;185;249m_open_engine\u001b[39m,\u001b[76G\u001b[38;2;177;185;249m_open_ta\u001b[85Gk_r\u001b[89Gpo\u001b[39m,\u001b[K\r\u001b[4C\u001b[1B\u001b[38;2;177;185;249m_open_hi\u001b[14Grarchy_repo\u001b[39m, \u001b[38;2;177;185;249m_open_tool_service\u001b[39m (all \u001b[38;2;177;185;249mcie/cli.py\u001b[39m) \u2014\u001b[65Gevery\u001b[71GCLI qu\u001b[78Gry \u001b[82Gommand builds\u001b[96Gits\r\u001b[2C\u001b[1B \u001b[5Gengine/repo through one of these.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[38;2;177;185;249mcie/facto\u001b[15Gy.py\u001b[39m: \u001b[38;2;177;185;249mbuild_driver\u001b[39m, \u001b[38;2;177;185;249mget_\u001b[40Gng\u001b[43Gn\u001b[45G\u001b[39m, \u001b[38;2;177;185;249mbuild_too\u001b[57G_service\u001b[39m \u2014 these are where \u001b[38;2;177;185;249m\"embedded\"\u001b[39m vs\u001b[K\r\u001b[4C\u001b[1B\u001b[38;2;177;185;249m\"neo4j\"\u001b[39m actually picks SQLi\u001b[33Ge-embedded\u001b[44Gstorage\u001b[52Gvs.\u001b[56Ga\u001b[58GNeo4j\u001b[64Gdriver.\r\u001b[8C\u001b[1B\u001b[38;2;177;185;249mmcp_server.py::main\u001b[39m branches directly\u001b[47Gon the string, so a third possibl\u001b[81G return value\u001b[95G(or\u001b[99Ga\r\u001b[4C\u001b[1Btypo in\u001b[13G\u001b[38;2;177;185;249m\"embedded\"\u001b[39m/\u001b[38;2;177;185;249m\"neo4j\"\u001b[39m) br\u001b[36Gaks the\u001b[44G\u001b[38;2;177;185;249mif/else\u001b[52G\u001b[39mthere\u001b[58Gsilently (falls\u001b[74Gto\u001b[77Gthe\u001b[81GNeo4j\u001b[87Gbranch).\r\u001b[8C\u001b[1B\u001b[38;2;177;185;249mroutes.py\u001b[39m: \u001b[38;2;177;185;249m_health_payload\u001b[39m, \u001b[38;2;177;185;249m_tool_coverage_report\u001b[39m, \u001b[38;2;177;185;249m_tool_coverage_trend\u001b[39m,\u001b[82G\u001b[38;2;177;185;249m_tool_get_coverage\u001b[39m\u001b[30;1H\u001b[28;3H\u001b[?25h"]
["o", 65.081026, "\u001b[?25l\u001b[H\u001b[3G\u001b[1mFile:\u001b[22m \u001b[38;2;177;185;249mcie/mcp_server.py:198\u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[1mWhat it does with the result:\u001b[33G\u001b[22mEntry\u001b[39Gpoint\u001b[45Gfor\u001b[49Gthe\u001b[53G\u001b[38;2;177;185;249mcie-mcp\u001b[61G\u001b[39mconsole\u001b[69Gscript.\u001b[77GPasses\u001b[84G\u001b[38;2;177;185;249margs.backend\u001b[39m,\r\u001b[2C\u001b[1B\u001b[38;2;177;185;249membedded_flag=args.embedded\u001b[31G\u001b[39m(the\u001b[36Glegacy\u001b[43G\u001b[38;2;177;185;249m--embedded\u001b[54G\u001b[39malias),\u001b[62Gand\u001b[66G\u001b[38;2;177;185;249mdb_path\u001b[39m.\u001b[75GBranches\u001b[84Gimmediately\u001b[96Gon\r\u001b[2C\u001b[1Bthe return value (\u001b[38;2;177;185;249m\"embedded\"\u001b[39m \u2192 \u001b[38;2;177;185;249mbuild_tool_service_embedded\u001b[39m, else \u2192 \u001b[38;2;177;185;249mbuild_tool_service_from_config\r\u001b[2C\u001b[1B\u001b[39m with Neo4j).\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BNo other non-test\u001b[21Gcode\u001b[26Gcalls\u001b[32Git\u001b[35Gdirectly\u001b[44G\u2014\u001b[46Git\u001b[49Greally\u001b[56Gis\u001b[59Gcentralized\u001b[71Gto\u001b[74Gthose\u001b[80Gtwo\u001b[84Gadapters,\u001b[94Gwhich\r\u001b[2C\u001b[1Bis\u001b[6Gthe\u001b[10Gpoint\u001b[16Gof\u001b[19Gthe\u001b[23G\"ONE\u001b[28Grule\"\u001b[34Gdocstring.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1m2. Downstream blast radius (from \u001b[38;2;177;185;249maffected_by\u001b[39m, distance 1\u21922)\r\u001b[2C\u001b[2B\u001b[22m- \u001b[38;2;177;185;249m_selected_backend\u001b[39m is itself wrapped by \u001b[45G\u001b[38;2;177;185;249m\u001b[1mopen_backend\u001b[22m\u001b[39m (\u001b[38;2;177;185;249mcie/cli.py:119-142\u001b[39m),\u001b[80Gwhich\u001b[86Gis\u001b[89Gthe\u001b[93Gactual\r\u001b[4C\u001b[1Bchokepoint\u001b[16Gevery\u001b[22GCLI\u001b[26Gquery\u001b[32Gcommand\u001b[40Ggoes\u001b[45Gthrough.\u001b[54GIt\u001b[57Gadditionally\u001b[70Graises\u001b[77G\u001b[38;2;177;185;249mFileNotFoundError\u001b[95G\u001b[39mif\r\u001b[2C\u001b[1B \u001b[5G\u001b[38;2;177;185;249mmode == \"embedde\u001b[22G\"\u001b[39m but the graph file doesn't exist \u2014 so a change that makes \u001b[38;2;177;185;249mresolve_backend\u001b[39m\u001b[K\r\u001b[4C\u001b[1Breturn \u001b[38;2;177;185;249m\"embedded\"\u001b[39m in\u001b[26Ga new\u001b[33Gase will surface as \u001b[3mthat\u001b[23m error, not a re\u001b[74Golve_backend error.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[38;2;177;185;249m_\u001b[7Gp\u001b[9Gn_backend\u001b[39m in turn gat\u001b[31Gs the four construction site\u001b[60G:\u001b[62G\u001b[38;2;177;185;249m_open_engine\u001b[39m,\u001b[76G\u001b[38;2;177;185;249m_open_ta\u001b[85Gk_r\u001b[89Gpo\u001b[39m,\u001b[K\r\u001b[4C\u001b[1B\u001b[38;2;177;185;249m_open_hi\u001b[14Grarchy_repo\u001b[39m, \u001b[38;2;177;185;249m_open_tool_service\u001b[39m (all \u001b[38;2;177;185;249mcie/cli.py\u001b[39m) \u2014\u001b[65Gevery\u001b[71GCLI qu\u001b[78Gry \u001b[82Gommand builds\u001b[96Gits\r\u001b[2C\u001b[1B \u001b[5Gengine/repo through one of these.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[38;2;177;185;249mcie/facto\u001b[15Gy.py\u001b[39m: \u001b[38;2;177;185;249mbuild_driver\u001b[39m, \u001b[38;2;177;185;249mget_\u001b[40Gng\u001b[43Gn\u001b[45G\u001b[39m, \u001b[38;2;177;185;249mbuild_too\u001b[57G_service\u001b[39m \u2014 these are where \u001b[38;2;177;185;249m\"embedded\"\u001b[39m vs\u001b[K\r\u001b[4C\u001b[1B\u001b[38;2;177;185;249m\"neo4j\"\u001b[39m actually picks SQLi\u001b[33Ge-embedded\u001b[44Gstorage\u001b[52Gvs.\u001b[56Ga\u001b[58GNeo4j\u001b[64Gdriver.\r\u001b[8C\u001b[1B\u001b[38;2;177;185;249mmcp_server.py::main\u001b[39m branches directly\u001b[47Gon the string, so a third possibl\u001b[81G return value\u001b[95G(or\u001b[99Ga\r\u001b[4C\u001b[1Btypo in\u001b[13G\u001b[38;2;177;185;249m\"embedded\"\u001b[39m/\u001b[38;2;177;185;249m\"neo4j\"\u001b[39m) br\u001b[36Gaks the\u001b[44G\u001b[38;2;177;185;249mif/else\u001b[52G\u001b[39mthere\u001b[58Gsilently (falls\u001b[74Gto\u001b[77Gthe\u001b[81GNeo4j\u001b[87Gbranch).\r\u001b[8C\u001b[1B\u001b[38;2;177;185;249mroutes.py\u001b[39m: \u001b[38;2;177;185;249m_health_payload\u001b[39m, \u001b[38;2;177;185;249m_tool_coverage_report\u001b[39m, \u001b[38;2;177;185;249m_tool_coverage_trend\u001b[39m,\u001b[82G\u001b[38;2;177;185;249m_tool_get_coverage\r\u001b[4C\u001b[1B\u001b[39m\u2014 health/coverage HTTP routes depend on which backend got constructed upstream.\u001b[K\r\u001b[8C\u001b[1B\u001b[38;2;177;185;249mt\u001b[11Gols/__init__.py::_speculative_engin\u001b[47G\u001b[39m and \u001b[38;2;177;185;249mcie/cli.py::bootst\u001b[72Gp\u001b[39m, \u001b[38;2;177;185;249mcli\u001b[39m, \u001b[38;2;177;185;249mwatch\u001b[39m \u2014 also\u001b[K\u001b[30;1H\u001b[28;3H\u001b[?25h"]
["o", 65.702769, "\u001b]0;\u25d0 resolve_backend call graph and tests\u0007\u001b[?25l\u001b[H\u001b[3Gthe return value (\u001b[38;2;177;185;249m\"embedded\"\u001b[32G\u001b[39m\u2192\u001b[34G\u001b[38;2;177;185;249mbuild_tool_service_embedded\u001b[39m,\u001b[63Gelse\u001b[68G\u2192\u001b[70G\u001b[38;2;177;185;249mbuild_tool_service_from_config\r\u001b[2C\u001b[1B\u001b[39m with Neo4j).\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BNo other \u001b[13Gon-test code calls\u001b[32Git directly \u2014 it really is centralized to those two adapters, which\u001b[K\r\u001b[2C\u001b[1Bis \u001b[8Ge p\u001b[12Gint of\u001b[19Gthe\u001b[23G\"ONE\u001b[28Grule\"\u001b[34Gdocstring.\r\u001b[2C\u001b[2B\u001b[1m2. Downstream blast radius (from \u001b[38;2;177;185;249maffected_by\u001b[39m, distance 1\u21922)\u001b[22m\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[38;2;177;185;249m_selected_backend\u001b[23G\u001b[39mis\u001b[26Gitself\u001b[33Gwrapped\u001b[41Gby\u001b[44G\u001b[38;2;177;185;249m\u001b[1m_open_backend\u001b[58G\u001b[22m\u001b[39m(\u001b[38;2;177;185;249mcie/cli.py:119-142\u001b[39m),\u001b[80Gwhich\u001b[86Gis\u001b[89Gthe\u001b[93Gactual\r\u001b[2C\u001b[1B  chokepoint every CLI query command goes through. It additionally\u001b[70Graises\u001b[77G\u001b[38;2;177;185;249mFileNotFoundError\u001b[95G\u001b[39mif\r\u001b[4C\u001b[1B\u001b[38;2;177;185;249mmode == \"embedded\"\u001b[24G\u001b[39mbut\u001b[28Gthe\u001b[32Ggraph\u001b[38Gfile\u001b[43Gdoesn't\u001b[51Gexist\u001b[57G\u2014\u001b[59Gso\u001b[62Ga\u001b[64Gchange\u001b[71Gthat\u001b[76Gmakes\u001b[82G\u001b[38;2;177;185;249mresolve_backend\r\u001b[2C\u001b[1B\u001b[39m \u001b[5Greturn \u001b[38;2;177;185;249m\"em\u001b[16Gedd\u001b[20Gd\"\u001b[24G\u001b[39mn\u001b[26Ga n\u001b[30Gw case will surface as \u001b[3mthat\u001b[58G\u001b[23merror, not a resolve_backend error.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[38;2;177;185;249m_open_backend\u001b[39m in\u001b[22Gturn gates the four const\u001b[48Guction sites: \u001b[38;2;177;185;249m_open_engine\u001b[39m, \u001b[38;2;177;185;249m_open_task_repo\u001b[39m,\u001b[K\r\u001b[4C\u001b[1B\u001b[38;2;177;185;249m_\u001b[7Gp\u001b[9Gn_hierarchy_repo\u001b[39m, \u001b[38;2;177;185;249m_open_tool_service\u001b[39m (all\u001b[51G\u001b[38;2;177;185;249mcie/cli.py\u001b[39m) \u2014 every\u001b[71GCLI query command builds its\r\u001b[4C\u001b[1Bengine/repo through one of\u001b[32Gthese.\u001b[K\r\u001b[4C\u001b[1B\u001b[38;2;177;185;249mcie/factory.py\u001b[39m: \u001b[38;2;177;185;249mbuild_driver\u001b[39m, \u001b[38;2;177;185;249mget_engine\u001b[39m, \u001b[38;2;177;185;249mbuild_tool_service\u001b[39m \u2014 these are where \u001b[38;2;177;185;249m\"emb\u001b[89Gdded\"\u001b[95G\u001b[39mvs\r\u001b[4C\u001b[1B\u001b[38;2;177;185;249m\"neo4j\"\u001b[39m actually picks SQLite-embedded storage vs. a Neo4j driver.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[38;2;177;185;249mcie/mcp_server.py::main\u001b[29G\u001b[39mbranches directly\u001b[47Gon\u001b[50Gthe\u001b[54Gstring,\u001b[62Gso\u001b[65Ga\u001b[67Gthird\u001b[73Gpossible\u001b[82Greturn\u001b[89Gvalue\u001b[95G(or\u001b[99Ga\r\u001b[2C\u001b[1B \u001b[5Gtypo in \u001b[38;2;177;185;249m\"embedded\"\u001b[39m/\u001b[38;2;177;185;249m\"neo4j\"\u001b[39m) breaks the \u001b[38;2;177;185;249mif/else\u001b[39m there silently (falls\u001b[74Gto the N\u001b[83Go4j branch).\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[38;2;177;185;249mci\u001b[8G/routes.py\u001b[39m: \u001b[38;2;177;185;249m_health_payload\u001b[39m, \u001b[38;2;177;185;249m_tool_coverage_report\u001b[39m, \u001b[38;2;177;185;249m_tool_coverage_trend\u001b[39m,\u001b[82G\u001b[38;2;177;185;249m_tool_get_coverage\r\u001b[2C\u001b[1B\u001b[39m \u001b[5G\u2014 health/coverage HTTP routes depend on which backend \u001b[60Got cons\u001b[68Gructed upstr\u001b[81Gam.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[38;2;177;185;249mcie/tools/__init__.py::_speculative_eng\u001b[45Gne\u001b[39m and\u001b[52G\u001b[38;2;177;185;249mcie/cli.py::bootstrap\u001b[39m, \u001b[38;2;177;185;249mcli\u001b[39m, \u001b[38;2;177;185;249mwatch\u001b[39m \u2014 also\u001b[K\r\u001b[2C\u001b[1B \u001b[5Gdownstream, though \u001b[38;2;177;185;249mwatch\u001b[39m/\u001b[38;2;177;185;249mbo\u001b[33Gtstrap\u001b[39m/\u001b[38;2;177;185;249mload\u001b[39m/\u001b[38;2;177;185;249ms\u001b[48Gve\u001b[39m are documented as intentionally bypassing this\u001b[K\r\u001b[4C\u001b[1B(Neo4j-only ingest commands per the \u001b[38;2;177;185;249m_open_backend\u001b[39m docstring).\u001b[K\r\u001b[2C\u001b[1B\u001b[K\u001b[30;1H\u001b[28;3H\u001b[?25h"]
["o", 66.254005, "\u001b[?25l\u001b[H\u001b[3G\u001b[1m2. Downstream blast radius (from \u001b[38;2;177;185;249maffected_by\u001b[39m, distance 1\u21922)\u001b[63G\u001b[22m\u001b[K\r\u001b[3C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[38;2;177;185;249m_selected_backend\u001b[23G\u001b[39mis\u001b[26Gitself\u001b[33Gwrapped\u001b[41Gby\u001b[44G\u001b[38;2;177;185;249m\u001b[1m_open_backend\u001b[58G\u001b[22m\u001b[39m(\u001b[38;2;177;185;249mcie/cli.py:119-142\u001b[39m),\u001b[80Gwhich\u001b[86Gis\u001b[89Gthe\u001b[93Gactual\r\u001b[2C\u001b[1B  chok\u001b[10Gpoint every CLI\u001b[26Gquery\u001b[32Gcommand goes through. It additionally raises \u001b[38;2;177;185;249mFileNotFoundError\u001b[39m if\u001b[K\r\u001b[2C\u001b[1B  \u001b[38;2;177;185;249mmode == \"embedded\"\u001b[39m but\u001b[28Gthe graph file doesn't\u001b[51Gexist\u001b[57G\u2014\u001b[59Gso\u001b[62Ga\u001b[64Gchange\u001b[71Gthat\u001b[76Gmakes\u001b[82G\u001b[38;2;177;185;249mresolve_backend\r\u001b[4C\u001b[1B\u001b[39mreturn\u001b[12G\u001b[38;2;177;185;249m\"embedded\"\u001b[23G\u001b[39min\u001b[26Ga\u001b[28Gnew\u001b[32Gcase\u001b[37Gwill\u001b[42Gsurface\u001b[50Gas\u001b[53G\u001b[3mthat\u001b[58G\u001b[23merror,\u001b[65Gnot\u001b[69Ga\u001b[71Gresolve_backend\u001b[87Gerror.\r\u001b[2C\u001b[1B- \u001b[38;2;177;185;249m_open_backend\u001b[39m in turn gates the four construction sites: \u001b[38;2;177;185;249m_open_engine\u001b[39m,\u001b[76G\u001b[38;2;177;185;249m_open_task_repo\u001b[39m,\r\u001b[4C\u001b[1B\u001b[38;2;177;185;249m_open_hierarchy_repo\u001b[39m,\u001b[27G\u001b[38;2;177;185;249m_open_tool_service\u001b[46G\u001b[39m(all\u001b[51G\u001b[38;2;177;185;249mcie/cli.py\u001b[39m)\u001b[63G\u2014\u001b[65Gevery\u001b[71GCLI\u001b[75Gquery\u001b[81Gcommand\u001b[89Gbuilds\u001b[96Gits\r\u001b[2C\u001b[1B \u001b[5Gengine/repo through one of these.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[38;2;177;185;249mcie/factory.py\u001b[39m: \u001b[38;2;177;185;249mbuild_driver\u001b[39m, \u001b[38;2;177;185;249mget_engine\u001b[39m, \u001b[38;2;177;185;249mbuild_tool_service\u001b[39m \u2014 these are where \u001b[38;2;177;185;249m\"embedded\"\u001b[95G\u001b[39mvs\r\u001b[4C\u001b[1B\u001b[38;2;177;185;249m\"neo4j\"\u001b[39m actually picks\u001b[28GSQLite-embedd\u001b[42Gd storage vs. a Ne\u001b[61G4j\u001b[64Gdriver.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[38;2;177;185;249mcie/mcp_server.py::main\u001b[39m branch\u001b[36Gs directly on\u001b[50Gthe string, so\u001b[65Ga \u001b[68Ghird p\u001b[75Gssible r\u001b[84Gturn value\u001b[95G(or\u001b[99Ga\r\u001b[2C\u001b[1B \u001b[5Gtypo in \u001b[38;2;177;185;249m\"embedded\"\u001b[39m/\u001b[38;2;177;185;249m\"neo4j\"\u001b[39m)\u001b[33Gbr\u001b[36Gaks the \u001b[38;2;177;185;249mif/else\u001b[39m there silently (falls to the Neo4j branch).\r\u001b[2C\u001b[1B-\u001b[5G\u001b[38;2;177;185;249mcie/rout\u001b[14Gs.py\u001b[39m: \u001b[21G\u001b[38;2;177;185;249mh\u001b[23Galth\u001b[28Gpayload\u001b[39m, \u001b[38G\u001b[38;2;177;185;249mtool_\u001b[44Goverage_r\u001b[54Gport\u001b[39m, \u001b[38;2;177;185;249m_tool_coverage_trend\u001b[39m, \u001b[38;2;177;185;249m_tool_get_coverage\r\u001b[4C\u001b[1B\u001b[39m\u2014 health/c\u001b[16Gverage HTTP r\u001b[30Gutes d\u001b[37Gpend\u001b[42Gon\u001b[45Gwhich\u001b[51Gbackend\u001b[59Ggot\u001b[63Gconstructed\u001b[75Gupstream.\r\u001b[8C\u001b[1B\u001b[38;2;177;185;249mtools/__init__.py::_sp\u001b[32Gculativ\u001b[40G_engine\u001b[39m and \u001b[38;2;177;185;249mcie/cli.py::bootstrap\u001b[39m, \u001b[38;2;177;185;249mcli\u001b[39m, \u001b[38;2;177;185;249mwatch\u001b[39m \u2014 also\u001b[K\r\u001b[4C\u001b[1Bdownstre\u001b[14Gm, though \u001b[38;2;177;185;249mwatch\u001b[39m/\u001b[38;2;177;185;249mbootstrap\u001b[39m/\u001b[38;2;177;185;249mload\u001b[39m/\u001b[38;2;177;185;249mserve\u001b[39m are documente\u001b[65G as intentionally\u001b[83Gbypassing\u001b[93Gthis\r\u001b[2C\u001b[1B \u001b[5G(Neo4j-only ingest commands per the 