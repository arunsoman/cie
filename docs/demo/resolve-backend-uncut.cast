["o", 62.832481, "\u001b[?25l\u001b[H\u001b[3G\u001b[1mFile:\u001b[22m \u001b[38;2;177;185;249mcie/cli.py:90\u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[1mWhat it does with the result:\u001b[33G\u001b[22mAdapter\u001b[41Gfor\u001b[45Gthe\u001b[49G\u001b[38;2;177;185;249mcie\u001b[53G\u001b[39mCLI.\u001b[58GPasses\u001b[65G\u001b[38;2;177;185;249mctx.obj[\"backend_opt\"]\u001b[88G\u001b[39m(the\r\u001b[2C\u001b[1B\u001b[38;2;177;185;249m--backend\u001b[39m/\u001b[38;2;177;185;249mCIE_BACKEND\u001b[39m value, possibly\u001b[41Gthe\u001b[45Gliteral\u001b[53Gstring\u001b[60G\u001b[38;2;177;185;249m\"auto\"\u001b[39m)\u001b[68Gand\r\u001b[2C\u001b[1B\u001b[38;2;177;185;249mdb_path=_embedded_db_path(...)\u001b[39m.\r\u001b[2C\u001b[1B\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[K\r\u001b[2C\u001b[1B\u001b[1mCaller:\u001b[22m \u001b[38;2;177;185;249mmain(argv)\u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[1mFile:\u001b[22m \u001b[38;2;177;185;249mcie/\u001b[14Gcp_s\u001b[19Grver.\u001b[25Gy:198\u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[1mWhat it does with the result:\u001b[22m Entry point\u001b[45Gfor\u001b[49Gthe\u001b[53G\u001b[38;2;177;185;249mcie-mcp\u001b[61G\u001b[39mconsole\u001b[69Gscript.\u001b[77GPasses\u001b[84G\u001b[38;2;177;185;249margs.backend\u001b[39m,\r\u001b[2C\u001b[1B\u001b[38;2;177;185;249membedded_flag=args.embedded\u001b[31G\u001b[39m(the\u001b[36Glegacy\u001b[43G\u001b[38;2;177;185;249m--embedded\u001b[54G\u001b[39malias),\u001b[62Gand\u001b[66G\u001b[38;2;177;185;249mdb_path\u001b[39m.\u001b[75GBranches\u001b[84Gimmediately\u001b[96Gon\r\u001b[2C\u001b[1Bthe return value (\u001b[38;2;177;185;249m\"embedded\"\u001b[32G\u001b[39m\u2192\u001b[34G\u001b[38;2;177;185;249mbuild_tool_service_embedded\u001b[39m,\u001b[63Gelse\u001b[68G\u2192\u001b[70G\u001b[38;2;177;185;249mbuild_tool_service_from_config\r\u001b[2C\u001b[1B\u001b[39m with Neo4j).\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BNo other \u001b[13Gon-test code calls\u001b[32Git directly \u2014 it really is centralized to those two adapters, which\u001b[K\r\u001b[2C\u001b[1Bis \u001b[8Ge p\u001b[12Gint of\u001b[19Gthe\u001b[23G\"ONE\u001b[28Grule\"\u001b[34Gdocstring.\r\u001b[2C\u001b[2B\u001b[1m2. Downstream blast radius (from \u001b[38;2;177;185;249maffected_by\u001b[39m, distance 1\u21922)\u001b[22m\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[38;2;177;185;249m_selected_backend\u001b[23G\u001b[39mis\u001b[26Gitself\u001b[33Gwrapped\u001b[41Gby\u001b[44G\u001b[38;2;177;185;249m\u001b[1m_open_backend\u001b[58G\u001b[22m\u001b[39m(\u001b[38;2;177;185;249mcie/cli.py:119-142\u001b[39m),\u001b[80Gwhich\u001b[86Gis\u001b[89Gthe\u001b[93Gactual\r\u001b[2C\u001b[1B  chokepoint every CLI query command goes through. It additionally\u001b[70Graises\u001b[77G\u001b[38;2;177;185;249mFileNotFoundError\u001b[95G\u001b[39mif\r\u001b[4C\u001b[1B\u001b[38;2;177;185;249mmode == \"embedded\"\u001b[24G\u001b[39mbut\u001b[28Gthe\u001b[32Ggraph\u001b[38Gfile\u001b[43Gdoesn't\u001b[51Gexist\u001b[57G\u2014\u001b[59Gso\u001b[62Ga\u001b[64Gchange\u001b[71Gthat\u001b[76Gmakes\u001b[82G\u001b[38;2;177;185;249mresolve_backend\r\u001b[2C\u001b[1B\u001b[39m \u001b[5Greturn \u001b[38;2;177;185;249m\"em\u001b[16Gedd\u001b[20Gd\"\u001b[24G\u001b[39mn\u001b[26Ga n\u001b[30Gw case will surface as \u001b[3mthat\u001b[58G\u001b[23merror, not a resolve_backend error.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[38;2;177;185;249m_open_backend\u001b[39m in\u001b[22Gturn gates the four const\u001b[48Guction sites: \u001b[38;2;177;185;249m_open_engine\u001b[39m, \u001b[38;2;177;185;249m_open_task_repo\u001b[39m,\u001b[K\r\u001b[4C\u001b[1B\u001b[38;2;177;185;249m_\u001b[7Gp\u001b[9Gn_hierarchy_repo\u001b[39m, \u001b[38;2;177;185;249m_open_tool_service\u001b[39m (all\u001b[51G\u001b[38;2;177;185;249mcie/cli.py\u001b[39m) \u2014 every\u001b[71GCLI query command builds its\r\u001b[4C\u001b[1Bengine/repo through one of\u001b[32Gthese.\u001b[K\r\u001b[4C\u001b[1B\u001b[38;2;177;185;249mcie/factory.py\u001b[39m: \u001b[38;2;177;185;249mbuild_driver\u001b[39m, \u001b[38;2;177;185;249mget_engine\u001b[39m, \u001b[38;2;177;185;249mbuild_tool_service\u001b[39m \u2014 these are where \u001b[38;2;177;185;249m\"emb\u001b[89Gdded\"\u001b[95G\u001b[39mvs\u001b[30;1H\u001b[28;3H\u001b[?25h"]
