_get_coverage\r\u001b[4C\u001b[1B\u001b[39m\u2014 health/coverage HTTP routes depend on which backend got constructed upstream.\u001b[K\r\u001b[8C\u001b[1B\u001b[38;2;177;185;249mt\u001b[11Gols/__init__.py::_speculative_engin\u001b[47G\u001b[39m and \u001b[38;2;177;185;249mcie/cli.py::bootst\u001b[72Gp\u001b[39m, \u001b[38;2;177;185;249mcli\u001b[39m, \u001b[38;2;177;185;249mwatch\u001b[39m \u2014 also\u001b[K\r\u001b[4C\u001b[1Bdownstream, though \u001b[38;2;177;185;249mwatch\u001b[39m/\u001b[38;2;177;185;249mbootstrap\u001b[39m/\u001b[38;2;177;185;249mload\u001b[39m/\u001b[38;2;177;185;249mserve\u001b[51G\u001b[39mare documented as in\u001b[73Gntionally bypassing\u001b[93Gthis\r\u001b[2C\u001b[1B \u001b[5G(Neo4j-only ingest commands per the \u001b[38;2;177;185;249m_ope\u001b[46G_backend\u001b[39m docstring).\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1m3. Tests that would catch a regression\u001b[22m\u001b[K\r\u001b[2C\u001b[2B\u001b[1mDirect, one per resolu\u001b[26Gion-o\u001b[32Gde\u001b[35G branch\u001b[43G\u001b[22m\u2014\u001b[45Gall\u001b[49Gin\u001b[52G\u001b[38;2;177;185;249mtests/test_backend_selection.py\u001b[39m,\u001b[85Ginside\u001b[92G\u001b[38;2;177;185;249mclass \r\u001b[2C\u001b[1BTestResolveBackend\u001b[39m:\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B- \u001b[38;2;177;185;249mtest_f\u001b[12Gag_beats_env_and_auto\u001b[34G\u001b[39m(L32)\u001b[40G\u2014\u001b[42Gexplicit\u001b[51G\u001b[38;2;177;185;249m--backend\u001b[61G\u001b[39mwins\u001b[66Gover\u001b[71Geverything\r\u001b[2C\u001b[1B-\u001b[5G\u001b[38;2;177;185;249mtest_env_beats_alias_and_auto\u001b[35G\u001b[39m(L40)\u001b[41G\u2014\u001b[43G\u001b[38;2;177;185;249mCIE_BACKEND\u001b[55G\u001b[39mwins\u001b[60Gover\u001b[65Gthe\u001b[69G\u001b[38;2;177;185;249m--embedded\u001b[80G\u001b[39malias\r\u001b[9C\u001b[1B\u001b[38;2;177;185;249membedd\u001b[17Gd_alias\u001b[25Gbeats_auto\u001b[39m (L46)\u001b[42G\u2014 legacy\u001b[53G\u001b[38;2;177;185;249membedded\u0