["o", 71.782629, "\u001b[?25l\u001b[H\u001b[3G\u001b[1mDirect, one per resolution-order branch\u001b[43G\u001b[22m\u2014\u001b[45Gall\u001b[49Gin\u001b[52G\u001b[38;2;177;185;249mtests/test_backend_selection.py\u001b[39m,\u001b[85Ginside\u001b[92G\u001b[38;2;177;185;249mclass \r\u001b[2C\u001b[1BTestResolveBackend\u001b[39m:\u001b[K\r\u001b[2C\u001b[2B- \u001b[38;2;177;185;249mtest_flag_beats_env_and_auto\u001b[39m (L32) \u2014 explicit \u001b[38;2;177;185;249m--backend\u001b[39m wins over everything\u001b[K\r\u001b[2C\u001b[1B- \u001b[38;2;177;185;249mtest_en\u001b[13G_beats_alias_and_auto\u001b[35G\u001b[39m(L40)\u001b[41G\u2014\u001b[43G\u001b[38;2;177;185;249mCIE_BACKEND\u001b[55G\u001b[39mwins\u001b[60Gover\u001b[65Gthe\u001b[69G\u001b[38;2;177;185;249m--embedded\u001b[80G\u001b[39malias\r\u001b[2C\u001b[1B-\u001b[5G\u001b[38;2;177;185;249mtest_embedded_alias_beats_auto\u001b[36G\u001b[39m(L46)\u001b[42G\u2014\u001b[44Glegacy\u001b[51G\u001b[38;2;177;185;249m--embedded\u001b[62G\u001b[39malias\u001b[68Gstill\u001b[74Gworks\r\u001b[9C\u001b[1B\u001b[38;2;177;185;249mauto\u001b[15Gprefers_existing_graph_file\u001b[39m (L51) \u2014\u001b[51Gauto-detect via \u001b[38;2;177;185;249mdb_path.exists()\r\u001b[10C\u001b[1Bxplici\u001b[18G_auto_fl\u001b[27Gg_f\u001b[31Glls_through_to_detection\u001b[39m (L58) \u2014 the specific bug f\u001b[83Gxed\u001b[87G2026-08-31:\r\u001b[2C\u001b[1B \u001b[5G\u001b[38;2;177;185;249m--backend auto\u001b[39m must fall through, not be treated as truthy\u001b[K\r\u001b[9C\u001b[1B\u001b[38;2;177;185;249menv_is_tolerant_not_fatal\u001b[39m (L68) \u2014 garbage \u001b[38;2;177;185;249mCIE_BACKEND\u001b[39m v\u001b[66Glue doesn't crash,\u001b[85Gfalls\u001b[91Gthrough\r\u001b[18C\u001b[1B\u001b[38;2;177;185;249menv_va\u001b[26Gue\u001b[29Gc\u001b[31Gn_be_passed\u001b[43Gin\u001b[39m (L77)\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BThese 7 are your regression net for the resolution-order logic itself \u2014 run \u001b[38;2;177;185;249mpytest \u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;177;185;249mtest\u001b[8G/t\u001b[11Gst_backend_selection.py -v\u001b[39m.\u001b[K\r\u001b[2C\u001b[2B\u001b[1mIndirect, catch breakage in the two adapters/downstream wiring:\u001b[22m\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[38;2;177;185;249mtests/test_mcp_server.py::test_real_toolservice_registers_cleanly_with_no_introspection_errors\u001b[100G\u001b[39m\u2014\r\u001b[2C\u001b[1B  exercises \u001b[38;2;177;185;249mmcp_server.main\u001b[39m's branch on the resolved backend.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[38;2;177;185;249mtests/test_standalone_smoke.py::test_tool_service_bootstraps_with_no_env_vars\u001b[83G\u001b[39m\u2014\u001b[85Gbootstraps\u001b[96Gwith\r\u001b[2C\u001b[1B \u001b[5Gno env, so it's sensitive to what the \"auto\" default resolves to.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[38;2;177;185;249mtests/test_o\u001b[18Gtional_depe\u001b[30Gdency_envelope.py::service\u001b[39m (fixture)\u001b[67G\u2014\u001b[69Gdepends\u001b[77Gon\u001b[80Gbackend\u001b[88Gresolution\u001b[99Gto\r\u001b[2C\u001b[1B \u001b[5Gbuild a service without the optional Neo4j dependency present.\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BIf you change the resolution order or add a new source (e.g. a config file),\u001b[80Gthe 7\u001b[K\u001b[30;1H\u001b[28;3H\u001b[?25h"]
["o", 72.318486, "\u001b]0;\u25d1 resolve_backend call graph and tests\u0007\u001b[?25l\u001b[H\u001b[3G\u001b[38;2;177;185;249mTestResolveBackend\u001b[39m:\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[38;2;177;185;249mtest_flag_beats_env_and_auto\u001b[34G\u001b[39m(L32)\u001b[40G\u2014\u001b[42Gexplicit\u001b[51G\u001b[38;2;177;185;249m--backend\u001b[61G\u001b[39mwins\u001b[66Gover\u001b[71Geverything\r\u001b[9C\u001b[1B\u001b[38;2;177;185;249menv_beats_alias_and_auto\u001b[39m (L40) \u2014 \u001b[38;2;177;185;249mCIE_BACKEND\u001b[39m wins over the \u001b[38;2;177;185;249m--embedded\u001b[39m alias\r\u001b[10C\u001b[1B\u001b[38;2;177;185;249mmbedded_alias_beats_auto\u001b[39m (L46) \u2014 legacy \u001b[38;2;177;185;249m--embedded\u001b[39m alias still works\u001b[80G\u001b[K\r\u001b[9C\u001b[1B\u001b[38;2;177;185;249mauto_prefers_existing_graph_file\u001b[39m (L51) \u2014\u001b[51Gauto-detect v\u001b[66G \u001b[38;2;177;185;249mdb_path.exists()\r\u001b[9C\u001b[1Bexplicit_auto_flag_falls_t\u001b[37Grough_to_detection\u001b[39m (L58) \u2014 the specific bug fixed\u001b[87G2026-08-31:\r\u001b[2C\u001b[1B \u001b[5G\u001b[38;2;177;185;249m--backend au\u001b[18Go\u001b[39m must fall through, not be treated as truthy\u001b[64G\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[38;2;177;185;249mtest_env_is_\u001b[19Glerant_not_fatal\u001b[39m (L68) \u2014 garbage \u001b[38;2;177;185;249mCIE_BACKEND\u001b[64G\u001b[39mvalue\u001b[70Gdoesn't\u001b[78Gcrash,\u001b[85Gfalls\u001b[91Gthrough\r\u001b[10C\u001b[1B\u001b[38;2;177;185;249mxpl\u001b[15Gci\u001b[18G_env_value_can_be_passed_in\u001b[39m (L77)\u001b[52G\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BThese\u001b[9G7\u001b[11Gare\u001b[15Gyour\u001b[20Gregression\u001b[31Gnet\u001b[35Gfor\u001b[39Gthe\u001b[43Gresolution-order\u001b[60Glogic\u001b[66Gitself\u001b[73G\u2014\u001b[75Grun\u001b[79G\u001b[38;2;177;185;249mpytest \r\u001b[2C\u001b[1Btests/test_backend_selection.py -v\u001b[39m.\u001b[39G\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mIndirect, catch breakage in the two adapters/downstream wiring:\r\u001b[2C\u001b[1B\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[38;2;177;185;249mtests/test_mcp_server.py::test_real_toolservice_registers_cleanly_with_no_introspection_errors\u001b[100G\u001b[39m\u2014\r\u001b[2C\u001b[1B \u001b[5Gexercises \u001b[38;2;177;185;249mmcp_server.main\u001b[39m's branch on the resolved backend.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[38;2;177;185;249mtests/test_standalone_smoke.py::test_tool_service_bootstraps_with_no_env_vars\u001b[83G\u001b[39m\u2014\u001b[85Gbootstraps\u001b[96Gwith\r\u001b[2C\u001b[1B \u001b[5Gno env, so it's sensitive to what the \"auto\" default resolves to.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[38;2;177;185;249mtests/test_optional_dependency_envelope.py::service\u001b[39m (fixtur\u001b[65G)\u001b[67G\u2014 depends\u001b[77Gon\u001b[80Gbackend\u001b[88Gresolution\u001b[99Gto\r\u001b[2C\u001b[1B \u001b[5Gbuild a service without the optional Neo4j dependency present.\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BIf\u001b[6Gyou\u001b[10Gchange\u001b[17Gthe\u001b[21Gresolution\u001b[32Gorder\u001b[38Gor\u001b[41Gadd\u001b[45Ga\u001b[47Gnew\u001b[51Gsource\u001b[58G(e.g.\u001b[64Ga\u001b[66Gconfig\u001b[73Gfile),\u001b[80Gthe\u001b[84G7\r\u001b[2C\u001b[1B\u001b[38;2;177;185;249mTestResolveBackend\u001b[39m cases are\u001b[32Gwhere\u001b[38Gto\u001b[45Gnew branch cov\u001b[60Grage first; then re-run\u001b[84Gthe\u001b[88G3\u001b[90Gindirect\u001b[30;1H\u001b[28;3H\u001b[?25h"]
["o", 72.870183, "\u001b[?25l\u001b[H\u001b[3G- \u001b[38;2;177;185;249mtest_en\u001b[13G_beats_alias_and_auto\u001b[35G\u001b[39m(L40)\u001b[41G\u2014\u001b[43G\u001b[38;2;177;185;249mCIE_BACKEND\u001b[55G\u001b[39mwins\u001b[60Gover\u001b[65Gthe\u001b[69G\u001b[38;2;177;185;249m--embedded\u001b[80G\u001b[39malias\r\u001b[2C\u001b[1B-\u001b[5G\u001b[38;2;177;185;249mtest_embedded_alias_beats_auto\u001b[36G\u001b[39m(L46)\u001b[42G\u2014\u001b[44Glegacy\u001b[51G\u001b[38;2;177;185;249m--embedded\u001b[62G\u001b[39malias\u001b[68Gstill\u001b[74Gworks\r\u001b[9C\u001b[1B\u001b[38;2;177;185;249mauto\u001b[15Gprefers_existing_graph_file\u001b[39m (L51) \u2014\u001b[51Gauto-detect via \u001b[38;2;177;185;249mdb_path.exists()\r\u001b[10C\u001b[1Bxplici\u001b[18G_auto_fl\u001b[27Gg_f\u001b[31Glls_through_to_detection\u001b[39m (L58) \u2014 the specific bug f\u001b[83Gxed\u001b[87G2026-08-31:\r\u001b[2C\u001b[1B \u001b[5G\u001b[38;2;177;185;249m--backend auto\u001b[39m must fall through, not be treated as truthy\u001b[K\r\u001b[9C\u001b[1B\u001b[38;2;177;185;249menv_is_tolerant_not_fatal\u001b[39m (L68) \u2014 garbage \u001b[38;2;177;185;249mCIE_BACKEND\u001b[39m v\u001b[66Glue doesn't crash,\u001b[85Gfalls\u001b[91Gthrough\r\u001b[18C\u001b[1B\u001b[38;2;177;185;249menv_va\u001b[26Gue\u001b[29Gc\u001b[31Gn_be_passed\u001b[43Gin\u001b[39m (L77)\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BThese 7 are your regression net for the resolution-order logic itself \u2014 run \u001b[38;2;177;185;249mpytest \u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;177;185;249mtest\u001b[8G/t\u001b[11Gst_backend_selection.py -v\u001b[39m.\u001b[K\r\u001b[2C\u001b[2B\u001b[1mIndirect, catch breakage in the two adapters/downstream wiring:\u001b[22m\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[38;2;177;185;249mtests/test_mcp_server.py::test_real_toolservice_registers_cleanly_with_no_introspection_errors\u001b[100G\u001b[39m\u2014\r\u001b[2C\u001b[1B  exercises \u001b[38;2;177;185;249mmcp_server.main\u001b[39m's branch on the resolved backend.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[38;2;177;185;249mtests/test_standalone_smoke.py::test_tool_service_bootstraps_with_no_env_vars\u001b[83G\u001b[39m\u2014\u001b[85Gbootstraps\u001b[96Gwith\r\u001b[2C\u001b[1B \u001b[5Gno env, so it's sensitive to what the \"auto\" default resolves to.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[38;2;177;185;249mtests/test_o\u001b[18Gtional_depe\u001b[30Gdency_envelope.py::service\u001b[39m (fixture)\u001b[67G\u2014\u001b[69Gdepends\u001b[77Gon\u001b[80Gbackend\u001b[88Gresolution\u001b[99Gto\r\u001b[2C\u001b[1B \u001b[5Gbuild a service without the optional Neo4j dependency present.\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BIf you change the resolution order or add a new source (e.g. a config file),\u001b[80Gthe 7\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;177;185;249mTestResolveBackend\u001b[39m cases are where to add new bra\u001b[53Gch \u001b[57Gove\u001b[61Gag\u001b[64G first;\u001b[72Gthen\u001b[77Gre-run\u001b[84Gthe\u001b[88G3\u001b[90Gindirect\r\u001b[2C\u001b[1Btests\u001b[9Gto\u001b[12Gconfirm\u001b[20Gthe\u001b[24Gadapters\u001b[33Gand\u001b[37Gdownstream\u001b[48Gfactory\u001b[56Gwiring\u001b[63Gstill\u001b[69Ghold.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;215;119;87m\u2722\u001b[3GSock-hopping\u2026 \u001b[38;2;153;153;153m(43s \u00b7 \u2193\u001b[39m \u001b[38;2;153;153;153m3.1k tokens)\u001b[39m\u001b[K\u001b[30;1H\u001b[28;3H\u001b[?25h\u001b]0;\u2733 resolve_backend call graph and tests\u0007\u001b[?25l\u001b[H\r\u001b[24B\u001b[38;2;153;153;153m\u273b\u001b[3GCrunched for 43s \u00b7\u001b[22Gdone 8:03 am\u001b[39m\u001b[K\r\u001b[3B\u276f\u00a0\r\u001b[44C\u001b[2B\u001b[38;2;153;153;153m\u2190 2\u001b[49Gagents\u001b[39m                   \u001b[30;1H\u001b[28;3H\u001b[?25h"]
