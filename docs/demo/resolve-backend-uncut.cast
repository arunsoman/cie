["o", 67.930658, "\u001b[?25l\u001b[H\u001b[5G\u001b[38;2;177;185;249mmode == \"embedded\"\u001b[39m but the\u001b[32Ggraph file doesn't exis\u001b[57G\u2014 so a change that makes \u001b[38;2;177;185;249mres\u001b[86Glve_backend\r\u001b[4C\u001b[1B\u001b[39mreturn \u001b[38;2;177;185;249m\"embed\u001b[19Ged\"\u001b[39m in a\u001b[28Gnew\u001b[32Gcase wil\u001b[41G surface as \u001b[3mthat\u001b[23m error, not a\u001b[71Gresolve_backend error.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[38;2;177;185;249m_open_backen\u001b[18G\u001b[39m in turn gates th\u001b[37Gfour\u001b[42Gconstruction sit\u001b[59Gs: \u001b[38;2;177;185;249m_open_engine\u001b[39m, \u001b[38;2;177;185;249m_open_task_repo\u001b[39m,\u001b[K\r\u001b[2C\u001b[1B \u001b[11G\u001b[38;2;177;185;249mhierarchy_repo\u001b[39m,\u001b[27G\u001b[38;2;177;185;249m_open_tool_service\u001b[39m (all \u001b[38;2;177;185;249mcie/cli.py\u001b[39m) \u2014 every CLI query command builds\u001b[96Gits\r\u001b[4C\u001b[1Bengine/repo through one of these.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[38;2;177;185;249mcie/factory.py\u001b[39m: \u001b[38;2;177;185;249mbuild_driver\u001b[39m, \u001b[38;2;177;185;249mget_engine\u001b[39m,\u001b[47G\u001b[38;2;177;185;249mbuild_tool_service\u001b[66G\u001b[39m\u2014\u001b[68Gthese\u001b[74Gare\u001b[78Gwhere\u001b[84G\u001b[38;2;177;185;249m\"embedded\"\u001b[95G\u001b[39mvs\r\u001b[2C\u001b[1B \u001b[5G\u001b[38;2;177;185;249m\"n\u001b[8Go4j\"\u001b[39m actually picks SQLite-embedded storage vs. a Neo4j driver.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[38;2;177;185;249mci\u001b[8G/mcp_server.py::main\u001b[39m branch\u001b[36Gs dir\u001b[42Gctly on the string, so a third\u001b[73Gpossible\u001b[82Greturn\u001b[89Gvalue\u001b[95G(or\u001b[99Ga\r\u001b[2C\u001b[1B \u001b[5Gtypo in \u001b[38;2;177;185;249m\"\u001b[15Gmb\u001b[18Gdded\"\u001b[39m/\u001b[38;2;177;185;249m\"neo4j\"\u001b[39m) br\u001b[36Gaks the \u001b[38;2;177;185;249mif/else\u001b[39m there silently\u001b[67G(falls to the Neo4j branch).\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[38;2;177;185;249mcie/routes.py\u001b[39m: \u001b[38;2;177;185;249m_health_payload\u001b[39m, \u001b[38;2;177;185;249m_tool_coverag\u001b[51G_report\u001b[39m, \u001b[38;2;177;185;249m_tool_coverage_trend\u001b[39m, \u001b[38;2;177;185;249m_tool_get_coverage\r\u001b[2C\u001b[1B\u001b[39m \u001b[5G\u2014 health/coverage HTTP routes depend on which backend got constructed upstream.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[38;2;177;185;249mcie/tools/__init__.py::_speculative_engine\u001b[39m and \u001b[38;2;177;185;249mcie/cli.py::bootstrap\u001b[39m,\u001b[75G\u001b[38;2;177;185;249mcli\u001b[39m, \u001b[38;2;177;185;249mwatch\u001b[86G\u001b[39m\u2014\u001b[88Galso\r\u001b[2C\u001b[1B \u001b[5Gdownstream, though \u001b[38;2;177;185;249mwatch\u001b[39m/\u001b[38;2;177;185;249mbootstrap\u001b[39m/\u001b[38;2;177;185;249mload\u001b[39m/\u001b[38;2;177;185;249ms\u001b[47Grve\u001b[39m are documented as intentionally bypassing\u001b[93Gthis\r\u001b[4C\u001b[1B(Neo4j-only\u001b[17Gingest\u001b[24Gcommands per the \u001b[38;2;177;185;249m_open_backend\u001b[58G\u001b[39mstring).\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1m3. Tests that would catch a regression\r\u001b[2C\u001b[1B\u001b[22m\u001b[K\r\u001b[2C\u001b[1B\u001b[1mDirect, one per resolution-order branch\u001b[43G\u001b[22m\u2014\u001b[45Gall\u001b[49Gin\u001b[52G\u001b[38;2;177;185;249mtests/test_backend_selection.py\u001b[39m,\u001b[85Ginside\u001b[92G\u001b[38;2;177;185;249mclass \r\u001b[2C\u001b[1BTestResolveBackend\u001b[39m:\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[38;2;177;185;249mtest_flag_beats_env_and_auto\u001b[34G\u001b[39m(L32)\u001b[40G\u2014\u001b[42Gexplicit\u001b[51G\u001b[38;2;177;185;249m--backend\u001b[61G\u001b[39mwins\u001b[66Gover\u001b[71Geverything\r\u001b[9C\u001b[1B\u001b[38;2;177;185;249menv_beats_alias_and_auto\u001b[39m (L40) \u2014 \u001b[38;2;177;185;249mCIE_BAC