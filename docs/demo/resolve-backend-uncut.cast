["o", 60.646084, "\u001b[?25l\u001b[H\r\u001b[4C\u001b[24B\u001b[38;2;177;185;249m_selected_backend\u001b[23G\u001b[39mis\u001b[26Gitself\u001b[33Gwrapped\u001b[41Gby\u001b[44G\u001b[38;2;177;185;249m\u001b[1m_open_backend\u001b[58G\u001b[22m\u001b[39m(\u001b[38;2;177;185;249mcie/cli.py:119-142\u001b[39m),\u001b[80Gwhich\u001b[86Gis\u001b[89Gthe\u001b[93Gactual\u001b[30;1H\u001b[28;3H\u001b[?25h"]
["o", 61.186002, "\u001b[?25l\u001b[H \u001b[3G\u001b[1mLocation:\u001b[22m \u001b[38;2;177;185;249mcie/config.py:155-197\u001b[39m\u001b[K\r\u001b[2C\u001b[2B\u001b[1m1. Direct callers (2 production call sites, both thin adapters)\r\u001b[2C\u001b[2BCalle\u001b[9G:\u001b[22m \u001b[38;2;177;185;249m_selected_backend(ctx)\u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[1mFile:\u001b[9G\u001b[22m\u001b[38;2;177;185;249mcie/cli.py:90\r\u001b[2C\u001b[1B\u001b[39m\u001b[1mWhat it does with the result:\u001b[22m Adapter\u001b[41Gfor\u001b[45Gthe\u001b[49G\u001b[38;2;177;185;249mcie\u001b[53G\u001b[39mCLI.\u001b[58GPasses\u001b[65G\u001b[38;2;177;185;249mctx.obj[\"backend_opt\"]\u001b[88G\u001b[39m(the\r\u001b[2C\u001b[1B\u001b[38;2;177;185;249m--backend\u001b[39m/\u001b[38;2;177;185;249mCIE_BACKEND\u001b[25G\u001b[39mvalue,\u001b[32Gpossibly\u001b[41Gthe\u001b[45Gliteral\u001b[53Gstring\u001b[60G\u001b[38;2;177;185;249m\"auto\"\u001b[39m)\u001b[68Gand\r\u001b[2C\u001b[1B\u001b[38;2;177;185;249mdb_path=_embedded_db_path(...)\u001b[39m.\u001b[K\r\u001b[2C\u001b[1B\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[K\r\u001b[2C\u001b[1B\u001b[1mCaller:\u001b[22m \u001b[38;2;177;185;249mmain(argv)\u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[1mFile:\u001b[22m \u001b[38;2;177;185;249mcie/mcp_server.py:198\u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[1mWhat it does with the result:\u001b[33G\u001b[22mEntry\u001b[39Gpoint\u001b[45Gfor\u001b[49Gthe\u001b[53G\u001b[38;2;177;185;249mcie-mcp\u001b[61G\u001b[39mconsole\u001b[69Gscript.\u001b[77GPasses\u001b[84G\u001b[38;2;177;185;249margs.backend\u001b[39m,\r\u001b[2C\u001b[1B\u001b[38;2;177;185;249membedded_flag=args.embedded\u001b[31G\u001b[39m(the\u001b[36Glegacy\u001b[43G\u001b[38;2;177;185;249m--embedded\u001b[54G\u001b[39malias),\u001b[62Gand\u001b[66G\u001b[38;2;177;185;249mdb_path\u001b[39m.\u001b[75GBranches\u001b[84Gimmediately\u001b[96Gon\r\u001b[2C\u001b[1Bthe return value (\u001b[38;2;177;185;249m\"embedded\"\u001b[39m \u2192 \u001b[38;2;177;185;249mbuild_tool_service_embedded\u001b[39m, else \u2192 \u001b[38;2;177;185;249mbuild_tool_service_from_config\r\u001b[2C\u001b[1B\u001b[39m with Neo4j).\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BNo other non-test\u001b[21Gcode\u001b[26Gcalls\u001b[32Git\u001b[35Gdirectly\u001b[44G\u2014\u001b[46Git\u001b[49Greally\u001b[56Gis\u001b[59Gcentralized\u001b[71Gto\u001b[74Gthose\u001b[80Gtwo\u001b[84Gadapters,\u001b[94Gwhich\r\u001b[2C\u001b[1Bis\u001b[6Gthe\u001b[10Gpoint\u001b[16Gof\u001b[19Gthe\u001b[23G\"ONE\u001b[28Grule\"\u001b[34Gdocstring.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1m2. Downstream blast radius (from \u001b[38;2;177;185;249maffected_by\u001b[39m, distance 1\u21922)\r\u001b[2C\u001b[2B\u001b[22m- \u001b[38;2;177;185;249m_selected_backend\u001b[39m is itself wrapped by \u001b[45G\u001b[38;2;177;185;249m\u001b[1mopen_backend\u001b[22m\u001b[39m (\u001b[38;2;177;185;249mcie/cli.py:119-142\u001b[39m),\u001b[80Gwhich\u001b[86Gis\u001b[89Gthe\u001b[93Gactual\r\u001b[4C\u001b[1Bchokepoint\u001b[16Gevery\u001b[22GCLI\u001b[26Gquery\u001b[32Gcommand\u001b[40Ggoes\u001b[45Gthrough.\u001b[54GIt\u001b[57Gadditionally\u001b[70Graises\u001b[77G\u001b[38;2;177;185;249mFileNotFoundError\u001b[95G\u001b[39mif\r\u001b[2C\u001b[1B \u001b[5G\u001b[38;2;177;185;249mmode == \"embedde\u001b[22G\"\u001b[39m but the graph file doesn't exist \u2014 so a change that makes \u001b[38;2;177;185;249mresolve_backend\u001b[39m\u001b[K\u001b[30;1H\u001b[28;3H\u001b[?25h"]
