{
  "$defs": {
    "ApiSpec": {
      "description": "Contract between Frontend and Backend.",
      "properties": {
        "endpoint": {
          "description": "e.g., POST /api/v1/import/parse-csv",
          "title": "Endpoint",
          "type": "string"
        },
        "request_schema": {
          "description": "JSON schema or exact TypeScript/Pydantic interface of the request body",
          "title": "Request Schema",
          "type": "string"
        },
        "response_schema": {
          "description": "JSON schema or exact interface of the response body",
          "title": "Response Schema",
          "type": "string"
        },
        "error_codes": {
          "description": "e.g., ['400 Bad Request', '500 Parse Error']",
          "items": {
            "type": "string"
          },
          "title": "Error Codes",
          "type": "array"
        }
      },
      "required": [
        "endpoint",
        "request_schema",
        "response_schema"
      ],
      "title": "ApiSpec",
      "type": "object"
    },
    "AtomicTask": {
      "description": "One Task = One File. The only model passed to the code generator.",
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "parent_ids": {
          "items": {
            "type": "string"
          },
          "title": "Parent Ids",
          "type": "array"
        },
        "child_ids": {
          "items": {
            "type": "string"
          },
          "title": "Child Ids",
          "type": "array"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "userstory_id": {
          "default": "",
          "title": "Userstory Id",
          "type": "string"
        },
        "parent_feature": {
          "default": "",
          "title": "Parent Feature",
          "type": "string"
        },
        "task_type": {
          "default": "dev",
          "description": "'dev' or 'qa'",
          "title": "Task Type",
          "type": "string"
        },
        "layer": {
          "default": "",
          "description": "'Backend' | 'Frontend' | 'API' | 'Data'",
          "title": "Layer",
          "type": "string"
        },
        "action": {
          "default": "create",
          "description": "'create' | 'modify' | 'delete'",
          "title": "Action",
          "type": "string"
        },
        "file_path": {
          "description": "Exact path from project root.",
          "title": "File Path",
          "type": "string"
        },
        "description": {
          "default": "",
          "description": "1-2 sentences exactly detailing what this file does.",
          "title": "Description",
          "type": "string"
        },
        "exact_imports": {
          "description": "List of exact import statements needed.",
          "items": {
            "type": "string"
          },
          "title": "Exact Imports",
          "type": "array"
        },
        "function_signatures": {
          "description": "Exact signatures.",
          "items": {
            "type": "string"
          },
          "title": "Function Signatures",
          "type": "array"
        },
        "step_by_step_implementation": {
          "description": "Numbered list of exact logic steps.",
          "items": {
            "type": "string"
          },
          "title": "Step By Step Implementation",
          "type": "array"
        },
        "dependencies": {
          "description": "Other file paths this task depends on",
          "items": {
            "type": "string"
          },
          "title": "Dependencies",
          "type": "array"
        },
        "api_spec": {
          "anyOf": [
            {
              "$ref": "#/$defs/ApiSpec"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Required if layer is API."
        },
        "test_triad": {
          "anyOf": [
            {
              "$ref": "#/$defs/TestTriad"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Required for 'dev' tasks."
        }
      },
      "required": [
        "name",
        "file_path"
      ],
      "title": "AtomicTask",
      "type": "object"
    },
    "TestTriad": {
      "description": "Ensures robust testing for every dev task.",
      "properties": {
        "positive": {
          "description": "Happy path test case.",
          "title": "Positive",
          "type": "string"
        },
        "negative": {
          "description": "Error path test case.",
          "title": "Negative",
          "type": "string"
        },
        "negative_to_positive": {
          "description": "Recovery/Fallback test case.",
          "title": "Negative To Positive",
          "type": "string"
        }
      },
      "required": [
        "positive",
        "negative",
        "negative_to_positive"
      ],
      "title": "TestTriad",
      "type": "object"
    }
  },
  "description": "Wrapper for the LLM to output a list of atomic tasks.",
  "properties": {
    "tasks": {
      "items": {
        "$ref": "#/$defs/AtomicTask"
      },
      "title": "Tasks",
      "type": "array"
    }
  },
  "required": [
    "tasks"
  ],
  "title": "AtomicTaskBatch",
  "type": "object"
}
